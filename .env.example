# Copy this file to ".env" and fill in the values. NEVER commit .env to GitHub.

# --- Meta WhatsApp Cloud API ---
# Permanent System User token (README step 3)
WHATSAPP_TOKEN=
# "Phone number ID" of the free test number (README step 2) - NOT the phone number itself
PHONE_NUMBER_ID=
# Any secret word you invent; you type the same word in Meta's webhook settings (step 5)
VERIFY_TOKEN=

# Optional: "WhatsApp Business Account ID" (next to the Phone number ID). Lets the bot
# check at start-up that Meta forwards messages to this app.
WABA_ID=

# --- LLM (Groq free tier by default) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Free key from https://console.groq.com/keys (starts with gsk_)
LLM_API_KEY=

# --- To use Google Gemini's free tier instead, replace the 4 lines above with: ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_FALLBACK_MODEL=gemini-2.0-flash-lite
# LLM_API_KEY=your-key-from-aistudio.google.com
